Options -Indexes
DirectoryIndex index.php

# ── Security headers ──────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Hide sensitive files ──────────────────────────
<FilesMatch "\.(env|sql|log|bak|sh|git)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package\.json|package-lock\.json)$">
  Require all denied
</FilesMatch>

# ── Block direct access to includes/config/database ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # XML sitemap served by PHP
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Block direct PHP includes access
  RewriteRule ^includes/       - [F,L]
  RewriteRule ^config/         - [F,L]
  RewriteRule ^database/       - [F,L]
  RewriteRule ^admin/header\.php$ - [F,L]
  RewriteRule ^admin/footer\.php$ - [F,L]

  # Pretty URLs (optional — maps /shop → shop.php etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# ── PHP settings (shared hosts) ───────────────────
<IfModule mod_php.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 8M
  php_value session.cookie_httponly 1
  php_value session.cookie_samesite "Lax"
</IfModule>

# ── Cache static assets ───────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg      "access plus 1 month"
  ExpiresByType image/png       "access plus 1 month"
  ExpiresByType image/webp      "access plus 1 month"
  ExpiresByType text/css        "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
